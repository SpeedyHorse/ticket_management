// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ORGANIZER
  STAFF
}

enum Provider {
  GOOGLE
  GITHUB
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventType {
  SINGLE_DAY
  MULTI_DAY
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
  REFUNDED
  EXPIRED
}

model User {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email String @unique

  walletAddress String? @unique
  encryptedPrivateKey String? @unique
  walletCreated Boolean @default(false)

  encryptionSalt String?
  encryptionIv String?

  role Role @default(CUSTOMER)

  accounts Account[]
  events Event[]
  tickets Ticket[]
}

model Account {
  id String @id @default(cuid())

  provider Provider
  providerId String
  email String?
  name String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  @@unique([provider, providerId])
  @@index([userId])
}

model Event {
  id String @id @default(cuid())
  title String
  description String
  venue String

  startDate DateTime
  endDate DateTime

  price Decimal
  totalTickets Int
  availableTickets Int

  organizer User @relation(fields: [organizerId], references: [id])
  organizerId String
  status EventStatus
  eventType EventType @default(SINGLE_DAY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizerId])
  @@index([status])
  @@index([startDate])

  tickets Ticket[]
}

model Ticket {
  id String @id @default(cuid())
  ticketNumber String @unique @default(cuid())
  purchaseDate DateTime @default(now())
  price Decimal

  eventId String
  userId String

  qrCode String @unique
  qrSignature String
  zkProofHash String

  status TicketStatus @default(VALID)

  event Event @relation(fields: [eventId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([eventId])
  @@index([userId])
  @@index([ticketNumber])
  @@index([status])

  security TicketSecurity?
}

model QuestionTemplate {
  id String @id @default(cuid())
  question String
  category String
  isActive Boolean @default(true)
  createdAt DateTime @default(now())

  @@index([category])
  @@index([isActive])
}

model TicketSecurity {
  id String @id @default(cuid())
  ticketId String @unique

  selectedQuestionIds String

  answersHash String
  zkProofHash String

  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
}
