// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ORGANIZER
  STAFF
}

enum Provider {
  GOOGLE
  GITHUB
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventType {
  SINGLE_DAY
  MULTI_DAY
}

model User {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email String @unique

  walletAddress String? @unique
  encryptedPrivateKey String? @unique
  walletCreated Boolean @default(false)

  role Role @default(CUSTOMER)

  accounts Account[]
  events Event[]
}

model Account {
  id String @id @default(cuid())

  provider Provider
  providerId String
  email String?
  name String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  @@unique([provider, providerId])
  @@index([userId])
}

model Event {
  id String @id @default(cuid())
  title String
  description String
  venue String

  startDate DateTime
  endDate DateTime

  price Decimal @db.Decimal(10, 2)
  totalTickets Int
  availableTickets Int

  organizer User @relation(fields: [organizerId], references: [id])
  organizerId String
  status EventStatus
  eventType EventType @default(SINGLE_DAY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizerId])
  @@index([status])
  @@index([startDate])
}
